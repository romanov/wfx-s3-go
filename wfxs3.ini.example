; Copy this file to the directory containing the file manager's main settings
; file and rename it to wfxs3.ini.
;
; Windows Total Commander: directory containing wincmd.ini.
; FreeBSD Double Commander: usually the Double Commander config directory.
;
; Credentials are intentionally plaintext in this MVP. Protect this file.

[my-server]
endpoint=https://s3.example.com
; Optional; defaults to us-east-1. Set a provider-specific signing region when needed.
; region=us-east-1
bucket=my-bucket
prefix=
access_key=ACCESS_KEY
secret_key=SECRET_KEY
session_token=
path_style=true
